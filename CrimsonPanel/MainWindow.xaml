<Window x:Class="CrimsonPanel.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" Title="PFF" Width="580" Height="640" MinWidth="310" MinHeight="455" WindowStyle="None" AllowsTransparency="True" Background="Transparent" Topmost="True" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <SolidColorBrush x:Key="AccentBrush" Color="#D12A2A"/>
  <SolidColorBrush x:Key="ActionBrush" Color="#B91C1C"/>
  <SolidColorBrush x:Key="TitleBrush" Color="#F04444"/>
  <SolidColorBrush x:Key="MainBrush" Color="#111111"/>
  <SolidColorBrush x:Key="HeaderBrush" Color="#202020"/>
  <SolidColorBrush x:Key="InputBrush" Color="#252525"/>
  <SolidColorBrush x:Key="TextBrush" Color="White"/>
  <SolidColorBrush x:Key="MutedBrush" Color="#BBBBBB"/>
  <Style TargetType="Button"><Setter Property="Background" Value="{DynamicResource ActionBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="ThemedScrollBar" TargetType="ScrollBar">
   <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
   <Setter Property="Width" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
    <Track x:Name="PART_Track" IsDirectionReversed="True" Orientation="Vertical" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ViewportSize="{TemplateBinding ViewportSize}">
     <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Background="Transparent" BorderThickness="0"/></Track.DecreaseRepeatButton>
     <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Margin="2,0"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Background="Transparent" BorderThickness="0"/></Track.IncreaseRepeatButton>
    </Track>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource ThemedScrollBar}"/>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Padding" Value="9,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="DarkCombo" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
   <Setter Property="Background" Value="{DynamicResource InputBrush}"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
    <Grid><ToggleButton x:Name="Toggle" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Background="{DynamicResource InputBrush}" BorderThickness="0">
     <Grid Background="{DynamicResource InputBrush}"><TextBlock Text="{Binding SelectedItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" VerticalAlignment="Center" Margin="12,0,34,0" Foreground="{DynamicResource TextBrush}" TextTrimming="CharacterEllipsis"/><Path Data="M 0,0 L 5,5 L 10,0" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,14,0"/></Grid>
    </ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer></Border></Popup>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="{DynamicResource InputBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="CaretBrush" Value="{DynamicResource TextBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/><Setter Property="Padding" Value="8"/><Setter Property="FontSize" Value="17"/></Style>
 </Window.Resources>
 <Border Background="{DynamicResource MainBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5" CornerRadius="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="24"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="{DynamicResource HeaderBrush}" CornerRadius="11,11,0,0" Margin="1,1,1,0" MouseLeftButtonDown="Header_MouseLeftButtonDown"><Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="36"/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
    <Button Grid.Column="0" Content="☰" Click="Menu_Click" Background="{DynamicResource InputBrush}" FontSize="23"/>
    <TextBlock Grid.Column="1" Text="PFF" Foreground="{DynamicResource TitleBrush}" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Margin="8,0"/>
    <TextBlock Grid.Column="2" x:Name="ClockText" Text="00:00:00" Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" FontSize="15" FontWeight="Bold"/>
    <Button Grid.Column="3" Content="—" Click="Minimize_Click" Background="Transparent"/>
    <Button Grid.Column="4" Content="×" Click="Close_Click" Background="Transparent"/>
   </Grid></Border>
   <Grid Grid.Row="1" Margin="14,12">
    <Grid x:Name="MenuPanel" Visibility="Collapsed"><StackPanel><TextBlock Text="РАЗДЕЛЫ" Foreground="{DynamicResource TitleBrush}" FontSize="19" FontWeight="Bold" Margin="4,0,0,15"/><Button Content="🎧  ЭКВАЛАЙЗЕР · НАУШНИКИ" Click="HeadphonesTab_Click" Height="54"/><Button Content="🎙  ЭКВАЛАЙЗЕР · МИКРОФОН" Click="MicrophoneTab_Click" Height="54"/><Button Content="⏱  СЕКУНДОМЕР" Click="StopwatchTab_Click" Height="54"/><Button Content="⏱  ТАЙМЕР" Click="TimerTab_Click" Height="54"/><Button Content="♪  МЕТРОНОМ" Click="MetronomeTab_Click" Height="54"/><Button Click="ClockTab_Click" Height="54"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Viewbox Width="20" Height="20" Margin="0,0,10,0"><Canvas Width="24" Height="24"><Ellipse Canvas.Left="2" Canvas.Top="2" Width="20" Height="20" Stroke="{DynamicResource TextBrush}" StrokeThickness="2"/><Path Data="M 12,6 L 12,12 L 17,15" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox><TextBlock Text="ЧАСЫ" VerticalAlignment="Center"/></StackPanel></Button><Button Content="⚙  НАСТРОЙКИ" Click="SettingsTab_Click" Height="54"/></StackPanel></Grid>

    <ScrollViewer x:Name="HeadphonesPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="🎧  ЭКВАЛАЙЗЕР НАУШНИКОВ" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Устройство воспроизведения" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,16,0,6"/>
      <ComboBox x:Name="OutputDevices" Style="{StaticResource DarkCombo}" Height="42" SelectionChanged="DeviceChanged" DropDownOpened="AudioDevices_DropDownOpened"/>
      <ComboBox x:Name="OutputDevicesPresets" Style="{StaticResource DarkCombo}" Margin="3,8,3,3" Height="42"/>
            <WrapPanel><Button Content="ПРИМЕНИТЬ" Click="ApplyPreset_Click" Tag="OutputDevices"/><Button Content="СОХРАНИТЬ" Click="SavePreset_Click" Tag="OutputDevices"/><Button Content="СБРОС" Click="ResetEq_Click" Tag="OutputDevices"/></WrapPanel>
      <TextBox x:Name="OutputDevicesPresetName" Margin="3,6,3,0" FontSize="14" ToolTip="Название нового пресета" Text="Новый пресет"/>
      <TextBlock x:Name="ApoStatusText" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="3,8,0,0"/>
      <WrapPanel Margin="0,5,0,0">
       <Button Content="ВКЛЮЧИТЬ / ПЕРЕПОДКЛЮЧИТЬ" Click="ConnectApo_Click" Height="40"/>
       <Button Content="ОТКЛЮЧИТЬ ОБРАБОТКУ PFF" Click="DisconnectGlobalApo_Click" Height="40" Background="{DynamicResource InputBrush}"/>
      </WrapPanel>
      <TextBlock Text="20-ПОЛОСНЫЙ ЭКВАЛАЙЗЕР" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,20,0,8"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="OutputBands" Orientation="Horizontal"/></ScrollViewer>
      <TextBlock Text="УСИЛЕНИЕ · дБ" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,16,0,4"/>
      <Grid MaxWidth="950"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Slider x:Name="OutputGain" Minimum="-12" Maximum="24" Value="0" TickFrequency="1" ValueChanged="AudioSliderChanged" HorizontalAlignment="Stretch" Margin="4,0,4,0"/><TextBlock x:Name="OutputGainValue" Grid.Row="1" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" Text="0 дБ"/></Grid>
      <TextBlock Text="КОМПРЕССОР" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,14,0,4"/>
      <Grid MaxWidth="950"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Slider x:Name="OutputCompression" ToolTip="Динамическая компрессия ReaComp" ToolTipService.ShowOnDisabled="True" Minimum="0" Maximum="100" ValueChanged="AudioSliderChanged" HorizontalAlignment="Stretch" Margin="4,0,4,0"/><TextBlock x:Name="OutputCompressionValue" Grid.Row="1" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" Text="0 %"/></Grid>
      <TextBlock Text="РЕВЕРБЕРАЦИЯ ЗАЛА" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,14,0,4"/>
      <Grid MaxWidth="950"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Slider x:Name="OutputReverb" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="0" Maximum="100" ValueChanged="AudioSliderChanged" HorizontalAlignment="Stretch" Margin="4,0,4,0"/><TextBlock x:Name="OutputReverbValue" Grid.Row="1" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" Text="0 %"/></Grid>
    </StackPanel></ScrollViewer>
    <ScrollViewer x:Name="MicrophonePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
      <TextBlock Text="🎙  ЭКВАЛАЙЗЕР МИКРОФОНА" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold"/>
      <TextBlock Text="Устройство записи" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,16,0,6"/>
      <ComboBox x:Name="InputDevices" Style="{StaticResource DarkCombo}" Height="42" SelectionChanged="DeviceChanged" DropDownOpened="AudioDevices_DropDownOpened"/>
      <TextBlock x:Name="ApoInputStatusText" TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" Margin="3,8,0,0"/>
      <WrapPanel Margin="0,5,0,0">
       <Button x:Name="CaptureTestButton" Content="ВКЛЮЧИТЬ МИКРОФОН PFF" Click="EnableMicrophone_Click" Height="40"/>
       <Button Content="УСТАНОВИТЬ VB-CABLE" Click="InstallMicrophoneDriver_Click" Height="40" Background="{DynamicResource InputBrush}"/>
       <Button x:Name="CaptureOffButton" Content="ВОССТАНОВИТЬ ЗАПИСЬ WINDOWS" Click="DisconnectCapture_Click" Height="40" Background="{DynamicResource InputBrush}"/>
      </WrapPanel>
      <ComboBox x:Name="InputDevicesPresets" Style="{StaticResource DarkCombo}" Margin="3,8,3,3" Height="42"/>
            <WrapPanel><Button Content="ПРИМЕНИТЬ" Click="ApplyPreset_Click" Tag="InputDevices"/><Button Content="СОХРАНИТЬ" Click="SavePreset_Click" Tag="InputDevices"/><Button Content="СБРОС" Click="ResetEq_Click" Tag="InputDevices"/></WrapPanel>
      <TextBox x:Name="InputDevicesPresetName" Margin="3,6,3,0" FontSize="14" ToolTip="Название нового пресета" Text="Новый пресет"/>
      <TextBlock Text="20-ПОЛОСНЫЙ ЭКВАЛАЙЗЕР" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,20,0,8"/>
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"><StackPanel x:Name="InputBands" Orientation="Horizontal"/></ScrollViewer>
      <TextBlock Text="УСИЛЕНИЕ · дБ" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,16,0,4"/>
      <Grid MaxWidth="950"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Slider x:Name="InputGain" Minimum="-12" Maximum="24" ValueChanged="AudioSliderChanged" HorizontalAlignment="Stretch" Margin="4,0,4,0"/><TextBlock x:Name="InputGainValue" Grid.Row="1" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" Text="0 дБ"/></Grid>
      <TextBlock Text="КОМПРЕССОР" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,14,0,4"/>
      <Grid MaxWidth="950"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Slider x:Name="InputCompression" ToolTip="Динамическая компрессия микрофона" ToolTipService.ShowOnDisabled="True" Minimum="0" Maximum="100" ValueChanged="AudioSliderChanged" HorizontalAlignment="Stretch" Margin="4,0,4,0"/><TextBlock x:Name="InputCompressionValue" Grid.Row="1" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" Text="0 %"/></Grid>
      <TextBlock Text="РЕВЕРБЕРАЦИЯ" Foreground="{DynamicResource TitleBrush}" FontWeight="Bold" Margin="3,14,0,4"/>
      <Grid MaxWidth="950"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Slider x:Name="InputReverb" IsSnapToTickEnabled="True" TickFrequency="1" Minimum="0" Maximum="100" ValueChanged="AudioSliderChanged" HorizontalAlignment="Stretch" Margin="4,0,4,0"/><TextBlock x:Name="InputReverbValue" Grid.Row="1" Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Right" Margin="0,0,8,0" Text="0 %"/></Grid>
    </StackPanel></ScrollViewer>
    <StackPanel x:Name="StopwatchPanel" Visibility="Collapsed">
      <TextBlock Text="СЕКУНДОМЕР" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold"/>
      <TextBlock x:Name="StopwatchText" Text="00:00.00" Foreground="{DynamicResource TextBrush}" FontSize="49" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,24"/>
      <TextBlock Text="Глобальная клавиша · старт / пауза" Foreground="{DynamicResource MutedBrush}" Margin="3,0,0,6"/>
      <Button x:Name="StopwatchHotkeyButton" Content="F7" Height="42" Background="{DynamicResource InputBrush}" Click="StopwatchHotkey_Click" PreviewKeyDown="StopwatchHotkey_PreviewKeyDown"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
        <Button x:Name="StopwatchButton" Content="СТАРТ" Width="160" Height="55" Click="StopwatchButton_Click"/>
        <Button Content="СБРОС" Width="120" Height="55" Background="{DynamicResource InputBrush}" Click="StopwatchReset_Click"/>
      </StackPanel>
    </StackPanel>
    <StackPanel x:Name="ClockPanel" Visibility="Collapsed">
      <TextBlock Text="ЧАСЫ" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold"/>
      <TextBlock x:Name="LargeClockText" Text="00:00:00" Foreground="{DynamicResource TextBrush}" FontSize="52" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,50,0,15"/>
      <TextBlock x:Name="ClockDateText" Foreground="{DynamicResource MutedBrush}" FontSize="18" HorizontalAlignment="Center"/>
    </StackPanel>
    <StackPanel x:Name="TimerPanel">
     <TextBlock Text="ТАЙМЕР" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold"/>
     <TextBlock x:Name="CountdownText" Text="00:05.0" Foreground="{DynamicResource TextBrush}" FontSize="49" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12"/>
     <TextBlock Text="Длительность (секунды)" Foreground="{DynamicResource MutedBrush}" Margin="3,0,0,5"/>
     <TextBox x:Name="SecondsBox" Text="5" PreviewTextInput="Numeric_PreviewTextInput" LostFocus="SecondsBox_LostFocus"/>
     <TextBlock Text="Глобальная клавиша" Foreground="{DynamicResource MutedBrush}" Margin="3,10,0,5"/>
     <Button x:Name="HotkeyButton" Content="F6" Background="{DynamicResource InputBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Height="40" HorizontalContentAlignment="Left" Click="HotkeyButton_Click" PreviewKeyDown="HotkeyButton_PreviewKeyDown"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"><Button x:Name="TimerButton" Content="СТАРТ" Width="140" Height="46" Click="TimerButton_Click"/><Button Content="СБРОС" Width="110" Height="46" Background="#393939" Click="ResetButton_Click"/></StackPanel>

    </StackPanel>
    <StackPanel x:Name="MetronomePanel" Visibility="Collapsed">
     <TextBlock Text="МЕТРОНОМ" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold"/>
     <TextBlock x:Name="BpmText" Text="120 BPM" Foreground="{DynamicResource TextBrush}" FontSize="48" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,25,0,15"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Button Content="−" Width="75" Height="55" Click="BpmMinus_Click"/><TextBox x:Name="BpmBox" Text="120" Width="95" Height="55" VerticalContentAlignment="Center" TextAlignment="Center" LostFocus="BpmBox_LostFocus" PreviewTextInput="Numeric_PreviewTextInput"/><Button Content="+" Width="75" Height="55" Click="BpmPlus_Click"/></StackPanel>
     <Button x:Name="MetronomeButton" Content="ЗАПУСТИТЬ" Height="55" Margin="10,25,10,0" Click="MetronomeButton_Click"/>
     <TextBlock Text="Ритм: один щелчок на каждую долю" Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </StackPanel>
    <ScrollViewer x:Name="SettingsPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="0,0,4,10">
      <TextBlock Text="⚙  НАСТРОЙКИ" Foreground="{DynamicResource TitleBrush}" FontSize="22" FontWeight="Bold" Margin="0,0,0,22"/>
      <TextBlock Text="ЗВУК ТАЙМЕРА И МЕТРОНОМА" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource TitleBrush}" Margin="3,0,0,6"/>
      <ComboBox x:Name="SoundCombo" Style="{StaticResource DarkCombo}" Height="42" SelectionChanged="SoundCombo_SelectionChanged">

      </ComboBox>
      <Button Content="ЗАГРУЗИТЬ СВОЙ WAV" Height="42" Background="{DynamicResource InputBrush}" Click="ImportSound_Click" Margin="3,8"/>
      <TextBlock x:Name="CustomSoundName" Text="Файл не выбран" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="4,0,0,12"/>
      <TextBlock Text="ТЕМА ОФОРМЛЕНИЯ" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource TitleBrush}" Margin="3,6,0,6"/>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
       <TextBlock x:Name="ThemeLabel" Text="Тёмная" Foreground="{DynamicResource TextBrush}" FontSize="16" VerticalAlignment="Center" Margin="5,0,15,0"/>
       <ToggleButton x:Name="ThemeSwitch" Width="64" Height="34" Click="ThemeSwitch_Click" Cursor="Hand">
        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Grid><Border x:Name="Track" CornerRadius="17" Background="#494949"/><Ellipse x:Name="Knob" Width="26" Height="26" Fill="White" HorizontalAlignment="Left" Margin="4,0,0,0"/></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template>
       </ToggleButton>
      </StackPanel>
      <TextBlock Text="АКЦЕНТНЫЙ ЦВЕТ" FontWeight="Bold" FontSize="17" Foreground="{DynamicResource TitleBrush}" Margin="3,20,0,8"/>
      <TextBlock Text="Выбери оттенок на круге" Foreground="{DynamicResource MutedBrush}" FontSize="12" Margin="3,0,0,6"/>
      <Image x:Name="ColorWheel" Width="190" Height="190" HorizontalAlignment="Center" Stretch="Fill" MouseLeftButtonDown="ColorWheel_MouseLeftButtonDown" MouseMove="ColorWheel_MouseMove" MouseLeftButtonUp="ColorWheel_MouseLeftButtonUp" LostMouseCapture="ColorWheel_LostMouseCapture" Cursor="Cross"/>
      <Button Content="ВЕРНУТЬ КРАСНЫЙ" Background="{DynamicResource InputBrush}" Click="ResetAccent_Click" Margin="3,12,3,0"/>
     </StackPanel>
    </ScrollViewer>
   </Grid>

   <primitives:Thumb Grid.Row="2" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" Background="{DynamicResource AccentBrush}" ToolTip="Изменить размер"/>
  </Grid>
 </Border>
</Window>
